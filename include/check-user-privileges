checkSudoers() {
	bUserSudo="$(LANG=C sudo -v -A 2>&1 && echo "true" || echo "false")" #bUserSudo=$(LANG=C sudo -v -A || echo "false") # if is sudo error no SUDO_ASKPASS otherwise not
	sKeyWord="try setting SUDO_ASKPASS"
	if [[ "${bUserSudo}" =~ "true" ]]; then bSudoerUser="true"; else bSudoerUser="false"; fi && echo "${bSudoerUser}" #[[ ${bUserSudo} =~ ${sKeyWord} ]] || 
} 
checkDoasUser() {					#set +x
	bUserDoas="$(LANG=C timeout -v 1 doas true 2>&1)" #echo "test doas valid user" 
	sKeyWord="doas: Operation not permitted"
	if [[ ! ${bUserDoas} =~ ${sKeyWord} ]]; then bDoasUser="true"; else bDoasUser="false"; fi && echo "${bDoasUser}"
}
getSuCmd() {						#set +x
	if [[ ! "${sSudoPath}" = "false" ]] && { [[ ! "${bSudoGrp}" = "false" ]] || [[ ! "${bSudoer}" = "false" ]] ; }; then sSuCmd="${sSudoPath}" #"/usr/bin/sudo"
	elif [[ ! "${sDoasPath}" = "false" ]] && [[ -f /etc/doas.conf ]] && [[ ! "${bSudoGrp}" = "false" ]]; then sSuCmd="${sDoasPath}" #"/usr/bin/doas"
	elif [[ $(whoami) = "root" ]]; then sSuCmd=" "; else sSuCmd="su - -c" #"su - -p -c"
	fi && echo "${sSuCmd}"
}
getSuCmdNoPreserveEnv() {			#set +x
	if [[ ! "${sSudoPath}" = "false" ]] && { [[ ! "${bSudoGrp}" = "false" ]] || [[ ! "${bSudoer}" = "false" ]] ; }; then sSuCmd="${sSudoPath}" #"/usr/bin/sudo"
	elif [[ ! "${sDoasPath}" = "false" ]] && [[ -f /etc/doas.conf ]] && [[ ! "${bSudoGrp}" = "false" ]]; then sSuCmd="${sDoasPath}" #"/usr/bin/doas"
	else sSuCmd="su - -c" #"su - -p -c"
	fi && echo "${sSuCmd}"
}
suExecCommand() {
	sCmd="$*"
	sSuPfx="$(getSuCmd)" #if ! sSuPfx="$(getSuCmd)"; then 					return 01; fi
	if [[ -n ${sCmd} ]]; then if ! checkRootPermissions; then eval "${sSuPfx} ${sCmd}"; else eval "${sCmd}"; fi
	fi && export sSuPfx
}
suExecCommandNoPreserveEnv() {
	sCmd="$*"
	sSuPfxNoEnv="$(getSuCmdNoPreserveEnv)" #if ! sSuPfxNoEnv="$(getSuCmdNoPreserveEnv)"; then 	return 01; fi
	if [[ -n ${sCmd} ]]; then if ! checkRootPermissions; then eval "${sSuPfxNoEnv} ${sCmd}"; else eval "${sCmd}"; fi
	fi && export sSuPfxNoEnv
}
checkRootPermissions() { if [[ ${UID} = 0 ]] || [[ ${EUID} = 0 ]]; then echo "true"; else echo "false"; return 1; fi; }
main_SU(){
	sSudoPath="$(command -v sudo || echo "false")"
	sDoasPath="$(command -v doas || echo "false")"
	if [[ ! "${sSudoPath}" = "false" ]]; then bSudoGrp="$(checkUserSudoOrWheelGroup)"; bSudoer="$(checkSudoers)"; else bSudoGrp="false"; bSudoer="false"; fi
	if [[ ! "${sDoasPath}" = "false" ]]; then bDoasUser="$(checkDoasUser)"; else bDoasUser="false"; fi				#suQuotes="$(getSuQuotes)"
	export -f checkRootPermissions
	export -f suExecCommand 				&& suExecCommand "" 
	export -f suExecCommandNoPreserveEnv 	&& suExecCommandNoPreserveEnv "" #if [[ -n "${sCmdParameters}" ]]; then suExecCommand "${sCmdParameters}" || suExecCommandNoPreserveEnv "${sCmdParameters}"; else : ; fi
}
main_SU
