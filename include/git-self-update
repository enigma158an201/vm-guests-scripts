#!/usr/bin/env bash

# script by enigma158an201, available at git repo by cloning: $ git clone https://github.com/enigma158an201/vm-guests-scripts.git
### this script is intended to be run on any Linux distribution to check for git updates and pull them if needed.###

updateScriptsViaGit(){
	set +euo pipefail #in case find cannot access some files or folders
	sTgtScript="$(find ~ -nowarn -type f -iname git-pull-refresh.sh 2>/dev/null)" # -exec {} \;
	set -euo pipefail
	if test -f "${sTgtScript}"; then	sGitFolder="$(dirname "${sTgtScript}")"; cd "${sGitFolder}" || exit 1; bash "${sTgtScript}"; fi #-x
}